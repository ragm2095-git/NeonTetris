{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Neon Tetris",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/NeonTetris.exe",
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Build Neon Tetris",
      "externalConsole": false,
      "setupCommands": [
        { "description": "Pretty-print STL", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
